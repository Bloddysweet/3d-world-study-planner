# Copy to server/.env.local. Enter secrets privately; never paste them in chat.
# Restart npm run dev (or npm run ai:server) after changing this file.
OPENROUTER_API_KEY=
# A separate random access code, minimum 16 characters. Enter it in the import dialog.
# Generate privately: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AI_IMPORT_ACCESS_CODE=
# Optional comma-separated model IDs. Only currently zero-price :free models with
# response-format support can be selected, even if a paid ID is entered here.
OPENROUTER_FREE_MODELS=
AI_IMPORT_DAILY_LIMIT=40
AI_API_PORT=3001
