{
  "name": "study-world-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:browser": "node scripts/check-app.mjs",
    "test:world": "node scripts/check-world.mjs",
    "test:pages": "node scripts/check-pages.mjs",
    "test:preview": "node scripts/check-preview.mjs",
    "test:header": "node scripts/check-header.mjs",
    "icons:export": "node scripts/export-icons.mjs",
    "test:icons": "node scripts/check-icons.mjs",
    "test:workspace": "node scripts/check-workspace.mjs",
    "test:exams": "node scripts/check-exams.mjs",
    "art:maths": "node scripts/build-maths-island.mjs",
    "test:maths-assets": "node scripts/validate-maths-art.mjs && python3 -m py_compile assets/blender/scripts/14_maths_art_island.py",
    "test:maths": "node scripts/check-maths-art.mjs",
    "art:all": "node scripts/build-all-islands.mjs",
    "test:art-assets": "node scripts/validate-all-islands.mjs && python3 -m py_compile assets/blender/scripts/14_maths_art_island.py assets/blender/scripts/15_all_subject_art_islands.py",
    "test:art": "node scripts/check-all-islands.mjs",
    "art:villagers": "node scripts/build-villagers.mjs",
    "test:villager-assets": "node scripts/validate-villagers.mjs && python3 -m py_compile assets/blender/scripts/16_animated_villagers.py",
    "test:villagers": "node scripts/check-villagers.mjs",
    "art:sky-creature": "node scripts/build-sky-creature.mjs",
    "sky:review": "node scripts/serve-sky-review.mjs",
    "test:sky-assets": "node scripts/validate-sky-creature.mjs && python3 scripts/validate-sky-blender.py && python3 -m py_compile assets/blender/scripts/17_aurel_sky_drake.py",
    "test:sky": "node scripts/check-sky-creature.mjs",
    "art:sky-animation": "node scripts/build-sky-animation.mjs",
    "test:sky-animation-assets": "node scripts/validate-sky-animation.mjs && python3 scripts/validate-sky-animation-blender.py && python3 -m py_compile assets/blender/scripts/18_aurel_flight_animation.py",
    "test:sky-animation": "node scripts/check-sky-animation.mjs",
    "art:sky-flight": "node scripts/publish-sky-flight.mjs",
    "test:sky-runtime-assets": "node scripts/validate-sky-runtime.mjs",
    "test:sky-flight": "node scripts/check-sky-flight.mjs",
    "test:sky-continuity": "node scripts/check-sky-continuity.mjs",
    "test:world-enhancements": "node scripts/check-world-enhancements.mjs",
    "test:world-entry": "node scripts/check-world-entry.mjs",
    "art:wild-dragon": "node scripts/build-male-dragon.mjs",
    "test:wild-assets": "node scripts/validate-wild-dragon.mjs",
    "test:wild-dragon": "node scripts/check-wild-dragon.mjs",
    "art:male-dragon": "node scripts/build-male-dragon.mjs",
    "test:male-assets": "node scripts/validate-wild-dragon.mjs",
    "test:dragon-pair": "node scripts/check-wild-dragon.mjs",
    "ai:server": "tsx server/start.ts",
    "test:ai": "vitest run src/domain/ai-targets.test.ts server/targets-api.test.ts",
    "test:ai:browser": "node --import tsx scripts/check-ai-import.mjs",
    "start": "tsx server/production.ts",
    "test:mobile-world": "node scripts/check-mobile-world.mjs",
    "test:accounts:browser": "node scripts/check-accounts.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0",
    "motion": "^12.23.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "three": "0.180.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  }
}
